class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int ans = 0;
        int n = nums.size();

        for(int i = 0; i < n; i++) {
            int number = nums[i];
            int cnt = 0;

            while(number > 0) {
                number /= 10;
                cnt++;
            }

            if(cnt % 2 == 0) {
                ans++;
            }
        }

        return ans;
    }
};
