class Solution {
public:
    int maximumWealth(vector<vector<int>>& accounts) {
        int n=accounts.size();
        
        vector<int>nums;
        for(int i=0;i<n;i++){
            int sum=0;
            for(int j=0;j<accounts[i].size();j++){
              
              sum+=accounts[i][j];
              nums.push_back(sum);
            }
            
        }
        int maxi=0;
        for(int i=0;i<nums.size();i++){
           
           maxi=max(maxi,nums[i]);
        }
        return maxi;
    }
};
