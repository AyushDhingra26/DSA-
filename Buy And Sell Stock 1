class Solution {
public:
    int maxProfit(vector<int>& prices) {
     int n=prices.size();
     int maxprofit=0;
     int buystock=prices[0];
     for(int i=1;i<n;i++){
        int profit=prices[i]-buystock;
        maxprofit=max(maxprofit,profit);
        buystock=min(buystock,prices[i]);
     }   
    return maxprofit;
    }
};
